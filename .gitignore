logs/

# Training run artifacts: every sweep cell writes outputs_<prefix>_<tag>/ (final model)
# and ckpt_<prefix>_<tag>/ (resume checkpoints + training_status.txt). Models are large and
# reproducible from the runner scripts + recorded config, so they stay out of git.
# Provenance lives in docs/model-results.md and the slurm-*.out logs.
outputs_*/
ckpt_*/
checkpoint/
checkpoint2/

# DFT dataset (2058 pickles, ~500 seqs x 4 contact variants) and its archive.
# Source of record is DNADataset/ upstream, not this repo.
pickle_files/
pickle_files.tar.gz

# MATLAB / NEGF intermediates
*.mat
*.jpg
*.jpeg
*.pdf
*.npz
*.npy
basic_example_results.png
training_results.png
training_curves.png

# Dataset regeneration: outputs stay out of the repo, the test fixture does not
pickle_files_v2/
*.h5
!tests/fixtures/dataset/**/*.mat
sample_predictions.png

